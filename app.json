      ],

      [
        "expo-build-properties",
        {
          "android": {
            "useAndroidX": true,
            "enableJetifier": true
          }
        }
      ],
      "./withAndroidManifestPlugin.js",
      "./withAndroidGradlePlugin.js"
    ],
