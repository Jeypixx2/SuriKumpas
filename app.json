            "./assets/kita_tayo_bukas.glb",
            "./assets/l.glb",
            "./assets/lalake.glb",
            "./assets/m.glb",
            "./assets/mabuti_naman_ako.glb",
            "./assets/magandang_gabi.glb",
            "./assets/magandang_hapon.glb",
            "./assets/magandang_umaga.glb",
            "./assets/mahina_ang_pandinig.glb",
            "./assets/march.glb",
